# Copy to .env.local and fill in from Supabase › Project Settings › API Keys.
# Without these the app runs in demo mode and messages stay on the phone.
# Both values are public by design (they ship inside the app); never put a secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
